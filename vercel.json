{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/leads",
      "destination": "/leads/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/scan",
      "schedule": "0 6 * * *"
    }
  ],
  "functions": {
    "api/cron/scan.js": {
      "maxDuration": 300,
      "memory": 1024
    },
    "api/leads.js": {
      "maxDuration": 30
    },
    "api/message.js": {
      "maxDuration": 60
    },
    "api/reached.js": {
      "maxDuration": 15
    },
    "api/probe.js": {
      "maxDuration": 60
    }
  }
}
